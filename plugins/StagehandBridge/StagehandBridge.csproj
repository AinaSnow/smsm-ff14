<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework><PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <Version>0.1.1</Version><AssemblyVersion>0.1.1.0</AssemblyVersion>
    <AssemblyName>SMSM.StagehandBridge</AssemblyName><AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <HooksPath Condition="'$(HooksPath)'==''">$(APPDATA)\XIVLauncher\addon\Hooks\15.0.3.6</HooksPath>
    <StagehandPath Condition="'$(StagehandPath)'==''">../../artifacts/stagehand-m0/checked-v2/package</StagehandPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
    <Reference Include="Dalamud;Lumina;Lumina.Excel;FFXIVClientStructs;InteropGenerator.Runtime">
      <HintPath>$(HooksPath)\%(Identity).dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="Stagehand.Api;Stagehand.Definitions"><HintPath>$(StagehandPath)/%(Identity).dll</HintPath><Private>true</Private></Reference>
    <None Update="SMSM.StagehandBridge.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
