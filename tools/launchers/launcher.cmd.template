@echo off
rem SMSM {ACTION}: double-click to run. Extra arguments are passed to tools\easy_install.py.
chcp 65001 >nul
set PYTHONUTF8=1
set PYTHONIOENCODING=utf-8
set "PY="
py -3 -c "import sys; sys.exit(sys.version_info < (3, 10))" >nul 2>nul && set "PY=py -3"
if not defined PY python -c "import sys; sys.exit(sys.version_info < (3, 10))" >nul 2>nul && set "PY=python"
if not defined PY (
  echo Python 3.10+ is required: https://www.python.org/downloads/
  echo During setup, tick "Add python.exe to PATH", then run this file again.
  pause
  exit /b 1
)
%PY% "%~dp0tools\easy_install.py" {ACTION} %*
set "CODE=%ERRORLEVEL%"
pause
exit /b %CODE%
