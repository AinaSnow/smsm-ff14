@echo off
rem SMSM {ACTION}: double-click to run. Extra arguments are passed to tools\easy_install.py.
rem Uses the bundled Python in .\python first; an installed Python 3.10+ is only a fallback.
chcp 65001 >nul
set PYTHONUTF8=1
set PYTHONIOENCODING=utf-8
set "PY="
if exist "%~dp0python\python.exe" set "PY="%~dp0python\python.exe""
if not defined PY py -3 -c "import sys; sys.exit(sys.version_info < (3, 10))" >nul 2>nul && set "PY=py -3"
if not defined PY python -c "import sys; sys.exit(sys.version_info < (3, 10))" >nul 2>nul && set "PY=python"
if not defined PY (
  echo The bundled python folder is missing. Extract the whole ZIP again, keeping the python folder.
  pause
  exit /b 1
)
%PY% "%~dp0tools\easy_install.py" {ACTION} %*
set "CODE=%ERRORLEVEL%"
pause
exit /b %CODE%
